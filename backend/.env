CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Payment Gateway Configuration
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""

# Email / OTP Configuration
