# JWT Secrets for Access and Refresh Token Rotation
JWT_SECRET="eventhub-secure-jwt-access-key-2026"
REFRESH_SECRET="eventhub-secure-jwt-refresh-key-2026"

# Port (Default: 3000)
PORT=3000

# Cloudinary Storage Configuration (Optional for cloud media persistence)
